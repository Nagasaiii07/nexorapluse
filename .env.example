# ====================================================================
# NEXUS Logistics Intelligence — Environment Configuration
# ====================================================================

# Environment Mode: development | staging | production
NODE_ENV=production
APP_ENV=production

# Server Configuration
PORT=8000
HOST=0.0.0.0
API_VERSION=1.0.0

# Database Configuration (PostgreSQL / Supabase / Neon)
# In production, provide your pooled Neon or Supabase PostgreSQL connection string.
# In local development, if left empty, SQLite (nexus.db) will automatically be used.
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/nexus?sslmode=require

# Frontend API URL
NEXT_PUBLIC_API_URL=/api

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://nexus-logistics.vercel.app

# Security & Secret Keys
JWT_SECRET=your-secure-random-jwt-secret-key-min-32-chars
API_KEY=your-nexus-internal-api-key

# Storage / Cloud Configuration (Optional)
S3_BUCKET_NAME=nexus-reports-storage
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
